generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  password              String
  name                  String
  role                  Role
  subscriptionPackageId String?
  subscriptionPackage   SubscriptionPackage? @relation(fields: [subscriptionPackageId], references: [id])
  household             Household?
  loginLog              LoginLog[]
  member                HouseholdMember?
  packageExpiredAt      DateTime?
}

// User (N) → (1) SubscriptionPackage    [User = child]
// User (1) → (1) Household              [User = parent]
// User (1) → (N) LoginLog               [User = parent]

model Household {
  id      String            @id @default(uuid())
  name    String
  userId  String            @unique
  user    User              @relation(fields: [userId], references: [id])
  members HouseholdMember[]
}

// Household (1) → (1) User   [Household = child]

model HouseholdMember {
  id          String    @id @default(uuid())
  name        String
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id])
  Profile     Profile[]
}

// HouseholdMember (1) → (1) Household   [HouseholdMember = child]
// HouseholdMember (1) → (1) User   [HouseholdMember = child]

model Profile {
  id                String           @id @default(uuid())
  name              String
  createdAt         DateTime         @default(now())
  deletedAt         DateTime?
  updatedAt         DateTime         @updatedAt
  image             String?
  favoriteMovieIds  String[]         @default([])
  householdMemberId String?
  householdMember   HouseholdMember? @relation(fields: [householdMemberId], references: [id])
}

// Profile (N) → (1) HouseholdMember   [Profile = child]

model SubscriptionPackage {
  id          String    @id @default(uuid())
  name        String
  maxProfiles Int
  maxMembers  Int
  price       Float
  resolution  String
  createdAt   DateTime? @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime? @updatedAt
  users       User[]
}

// SubscriptionPackage (1) → (N) User   [SubscriptionPackage = parent]

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// LoginLog (N) → (1) User   [LoginLog = child]

model Movie {
  id          String    @id @default(uuid())
  title       String
  thumbnail   String
  video       String
  description String
  category    String[]
  releaseDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

enum Role {
  OWNER
  MEMBER
}
