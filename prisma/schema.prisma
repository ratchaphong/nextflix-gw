generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  password              String
  name                  String
  role                  Role
  subscriptionPackageId String?
  household             Household?
  profiles              Profile[]
  subscriptionPackage   SubscriptionPackage? @relation(fields: [subscriptionPackageId], references: [id])
  LoginLog              LoginLog[]
}

model Household {
  id      String            @id @default(uuid())
  name    String
  userId  String            @unique
  user    User              @relation(fields: [userId], references: [id])
  members HouseholdMember[]
}

model HouseholdMember {
  id          String    @id @default(uuid())
  name        String
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
}

model Profile {
  id        String    @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt
  image     String?
  user      User      @relation(fields: [userId], references: [id])
}

model SubscriptionPackage {
  id          String    @id @default(uuid())
  name        String
  maxProfiles Int
  maxMembers  Int
  price       Float
  resolution  String
  createdAt   DateTime? @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime? @updatedAt
  users       User[]
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Movie {
  id          String    @id @default(uuid())
  title       String
  thumbnail   String
  video       String
  description String
  category    String[]
  releaseDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

enum Role {
  OWNER
  MEMBER
}
